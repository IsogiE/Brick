{
	email admin@lusaggo.com
	servers {
		max_header_size 16KB
		timeouts {
			read_header 10s
			read_body 15s
			write 30s
			idle 1m
		}
	}
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
}

{$BRICK_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 32768
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# The API sets no-referrer, except the authenticated player wrapper which
		# needs strict-origin-when-cross-origin for official YouTube embeds.
		-Server
	}

	reverse_proxy api:8080 {
		header_up X-Brick-Client-IP {remote_host}
		transport http {
			dial_timeout 3s
			response_header_timeout 20s
		}
	}
}
