BRICK_DOMAIN=brick.example.com
DISCORD_GUILD_ID=
DISCORD_OFFICER_ROLE_ID=
DISCORD_RAIDER_ROLE_ID=
ONLINE_WINDOW_SECONDS=180
ROSTER_CACHE_SECONDS=60
HEARTBEAT_RETENTION_SECONDS=1209600
REQUESTER_CACHE_SECONDS=300
REQUESTER_STALE_SECONDS=3600
OAUTH_HANDOFF_TTL_SECONDS=180
OAUTH_HANDOFF_MAX_ENTRIES=512
DISCORD_GATEWAY_ENABLED=true

# Exact public API origin hosting the authenticated stream player page.
# HTTP is allowed only for localhost/127.0.0.1 when testing locally.
BRICK_PLAYER_ORIGIN=https://brick.example.com

# Optional stream providers; credentials stay on the server.
# Each also accepts a corresponding _FILE variable for a mounted secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Public OAuth client registered for PKCE; report visibility is unchanged.
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_GUILD_ID=580482
