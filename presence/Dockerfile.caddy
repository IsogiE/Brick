FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY proxy/go.mod proxy/go.sum ./
RUN go mod download && go mod verify
# Caddy 2.11.4's two optimized CEL calls predate the CEL 0.29 interface rename.
# Verify the exact original and patched bytes; retain the upstream CEL security fix.
RUN matcher=/go/pkg/mod/github.com/caddyserver/caddy/v2@v2.11.4/modules/caddyhttp/celmatcher.go; \
    echo "e0fb48fde80ea23f7810e0e7f3fb2998032a6bea052deedaaeb02881d6c8cc6b  $matcher" | sha256sum -c - \
    && sed -i 's/\[\]interpreter.Interpretable{reqAttr}/[]interpreter.InterpretableV2{reqAttr}/g' "$matcher" \
    && echo "e4a3578e3307cb0d97b3d140aff2a8d14fb2147d0fd5122c1d94e523c3ed89bb  $matcher" | sha256sum -c -
COPY proxy/main.go ./
RUN go build -mod=readonly -trimpath -ldflags="-s -w" -o /build/caddy .

FROM caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
RUN apk upgrade --no-cache
COPY --from=build /build/caddy /usr/bin/caddy
