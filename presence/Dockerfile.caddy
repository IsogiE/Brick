FROM golang:1.26.7-alpine@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468 AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY proxy/go.mod proxy/go.sum ./
RUN go mod download && go mod verify
COPY proxy/main.go ./
RUN go build -mod=readonly -trimpath -ldflags="-s -w" -o /build/caddy .

FROM caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
RUN apk upgrade --no-cache
COPY --from=build /build/caddy /usr/bin/caddy
