FROM rust:1.98.1-bookworm@sha256:9a73a5088750b4c95158ab26629c854c3d6fc4b173cb7bc8079ad252d8ed7bfa AS reader
WORKDIR /build
COPY presence/reader/Cargo.toml presence/reader/Cargo.lock ./presence/reader/
COPY presence/reader/src ./presence/reader/src
COPY src/replay_digits.rs src/replay_edge.rs ./src/
COPY src/assets/replay-digits.json ./src/assets/replay-digits.json
RUN cargo build --locked --release --manifest-path presence/reader/Cargo.toml

# Only the codecs, containers, protocols and filters used by timestamp scanning
# are compiled. No subtitle, device, GPU, XML or arbitrary external-codec stack.
FROM node:22-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284 AS media
ARG FFMPEG_VERSION=9.0.1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential nasm pkg-config curl xz-utils ca-certificates zlib1g-dev libssl-dev libdav1d-dev \
    && curl --fail --location --retry 3 https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz -o /tmp/ffmpeg.tar.xz \
    && echo 'cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635  /tmp/ffmpeg.tar.xz' | sha256sum -c - \
    && mkdir /build && tar -xJf /tmp/ffmpeg.tar.xz --strip-components=1 -C /build
WORKDIR /build
RUN ./configure --prefix=/opt/ffmpeg --disable-everything --disable-autodetect --disable-doc --disable-debug \
    --enable-ffmpeg --enable-ffprobe --enable-network --enable-openssl --enable-zlib --enable-libdav1d \
    --enable-protocol=file,http,https,tcp,tls,crypto,data \
    --enable-demuxer=mov,matroska,mpegts,hls --enable-muxer=image2 \
    --enable-decoder=h264,hevc,vp8,vp9,libdav1d --enable-parser=h264,hevc,vp8,vp9,av1 \
    --enable-encoder=png --enable-filter=crop,fps,trim,format,scale,null \
    && make -j2 && make install \
    && install -Dm644 COPYING.LGPLv2.1 /opt/ffmpeg/share/COPYING.LGPLv2.1

FROM node:22-trixie-slim@sha256:7b8a0c89c54499bee567618f96578e1a12a800f062fbdbfd1fb6a443fa6f6284
ENV NODE_ENV=production PATH=/opt/media/bin:$PATH
COPY presence/requirements.txt /tmp/requirements.txt
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends python3-venv ca-certificates libssl3t64 zlib1g libdav1d7 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/media \
    && /opt/media/bin/pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/requirements.txt \
    && /opt/media/bin/pip uninstall -y pip setuptools \
    && rm /tmp/requirements.txt \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-v* \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app
COPY LICENSE src/assets/PTSansNarrow-LICENSE.txt ./
COPY --from=media /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe /usr/local/bin/
COPY --from=media /opt/ffmpeg/share/COPYING.LGPLv2.1 /usr/local/share/ffmpeg/
COPY --from=reader /build/presence/reader/target/release/brick-timestamp-reader ./
COPY presence/timestamp_worker.mjs presence/timestamp_queue.mjs presence/timestamp_process.mjs presence/timestamp_scan.py presence/timestamp_youtube.py presence/timestamp_frames.py presence/replay_sync.mjs presence/security.mjs ./
RUN mkdir /scratch && chown node:node /scratch
USER node
CMD ["node", "timestamp_worker.mjs"]
